<%- include('partials/header', { title: note.title }) %>
<a href="/note?cat=<%= note.category || 'alochona' %>" class="back"><svg class="icon sm"><use href="#i-back"/></svg> সব নোট</a>
<article class="detail reveal in">
  <span class="badge light"><%= (typeof cats !== 'undefined' && cats && cats[note.category]) || (note.category === 'boi' ? 'বই নোট' : 'আলোচনা নোট') %></span>
  <% if (note.phase === 'abedonpotrer-purbe') { %><span class="badge light">আবেদনপত্রের পূর্বে</span><% } %>
  <% if (note.phase === 'proshnopotrer-purbe') { %><span class="badge light">প্রশ্নপত্রের পূর্বে</span><% } %>
  <h1><%= note.title %></h1>
  <small class="muted"><svg class="icon sm"><use href="#i-clock"/></svg> <%= note.createdAt ? new Date(note.createdAt).toLocaleDateString('bn-BD') : '' %></small>
  <div class="content"><%- bnHtml(note.content) %></div>
  <a href="/note" class="btn"><svg class="icon"><use href="#i-note"/></svg> আরও নোট পড়ুন</a>
</article>
<%- include('partials/footer') %>
