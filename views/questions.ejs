<%- include('partials/header', { title: 'গুরুত্বপূর্ণ প্রশ্নোত্তর' }) %>
<section class="sec-qa">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-help"/></svg></span>
    <h2>গুরুত্বপূর্ণ প্রশ্ন</h2>
  </div>
  <p class="hint">যেকোনো প্রশ্নে চাপ দিলেই নিচে উত্তর খুলে যাবে। প্রতিটি প্রশ্নের আলাদা লিংক আছে।</p>

  <div class="chips">
    <a href="/questions" class="chip <%= !phase ? 'active' : '' %>">সব পর্ব</a>
    <a href="/questions/phase/abedonpotrer-purbe" class="chip <%= phase === 'abedonpotrer-purbe' ? 'active' : '' %>">আবেদনপত্রের পূর্বে</a>
    <a href="/questions/phase/proshnopotrer-purbe" class="chip <%= phase === 'proshnopotrer-purbe' ? 'active' : '' %>">প্রশ্নপত্রের পূর্বে</a>
    <a href="/questions/phase/shopother-purbe" class="chip <%= phase === 'shopother-purbe' ? 'active' : '' %>">শপথের পূর্বে</a>
  </div>

  <% if (typeof subjects !== 'undefined' && subjects && subjects.length) { %>
  <div class="chips">
    <a href="/questions" class="chip <%= !subject ? 'active' : '' %>">সব বিষয়</a>
    <% subjects.forEach(s => { %>
      <a href="/questions/subject/<%= encodeURIComponent(s) %>" class="chip <%= subject === s ? 'active' : '' %>"><%= s %></a>
    <% }) %>
  </div>
  <% } %>

  <form method="GET" action="/questions" class="search">
    <input type="text" name="q" placeholder="প্রশ্ন খুঁজুন..." value="<%= q %>" maxlength="100">
    <button type="submit"><svg class="icon sm"><use href="#i-search"/></svg> খুঁজুন</button>
  </form>

  <%- include('partials/qa-list', { items: questions, prefix: 'list' }) %>
</section>
<%- include('partials/footer') %>
