<%- include('partials/header', { title: 'প্রশ্নোত্তর' }) %>
<a href="/questions" class="back"><svg class="icon sm"><use href="#i-back"/></svg> সব প্রশ্ন</a>
<article class="detail reveal in">
  <span class="badge"><%= item.subject %></span>
  <% if (item.chapter) { %><span class="badge light"><%= item.chapter %></span><% } %>
  <% if (typeof phases !== 'undefined' && phases && item.phase && phases[item.phase]) { %><span class="badge light"><%= phases[item.phase] %></span><% } %>
  <h1><%= item.question %></h1>
  <div class="answer-box">
    <strong><svg class="icon sm"><use href="#i-check"/></svg> উত্তর:</strong>
    <p><%= item.answer %></p>
  </div>
  <p class="muted share-row">স্থায়ী লিংক: <code>/questions/<%= item.slug || item._id %></code></p>
  <a href="/questions" class="btn primary"><svg class="icon"><use href="#i-help"/></svg> আরও প্রশ্ন চর্চা করুন</a>
</article>

<% if (typeof related !== 'undefined' && related && related.length) { %>
<section class="sec-qa">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-layers"/></svg></span>
    <h2>সম্পর্কিত প্রশ্ন</h2>
  </div>
  <div class="qa-list">
    <% related.forEach(r => { %>
      <div class="qa-item">
        <a class="qa-q link" href="/questions/<%= r.slug || r._id %>"><span><%= r.question %></span><svg class="icon chev-right"><use href="#i-chev"/></svg></a>
      </div>
    <% }) %>
  </div>
</section>
<% } %>
<%- include('partials/footer') %>
