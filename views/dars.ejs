<%- include('partials/header', { title: 'দারস' }) %>
<section class="sec-note">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-book"/></svg></span>
    <h2>দারস</h2>
  </div>
  <p class="page-sub">দারস — পর্ব অনুযায়ী। মাসনুন দুআ পড়ুন <a href="/dua">আলাদা বিভাগে</a>।</p>

  <div class="chips">
    <a href="/dars" class="chip <%= !phase ? 'active' : '' %>">সব পর্ব</a>
    <% Object.entries(phases).forEach(([val, label]) => { %>
      <a href="/dars/porbo/<%= val %>" class="chip <%= phase === val ? 'active' : '' %>"><%= label %></a>
    <% }) %>
  </div>

  <form method="GET" action="/dars" class="search">
    <input type="text" name="q" placeholder="দারস খুঁজুন..." value="<%= q %>" maxlength="100">
    <% if (phase) { %><input type="hidden" name="phase" value="<%= phase %>"><% } %>
    <button type="submit"><svg class="icon sm"><use href="#i-search"/></svg> খুঁজুন</button>
  </form>
  <div class="feed">
    <% if (lessons.length === 0) { %><p class="empty">কোনো দারস পাওয়া যায়নি। অন্য পর্ব বা অন্য কিছু লিখে খুঁজুন।</p><% } %>
    <% lessons.forEach((l, idx) => { %>
      <article class="card social reveal">
        <div class="post-head">
          <span class="avatar av<%= (idx % 3) + 1 %>"><%= (l.title || 'দ').charAt(0) %></span>
          <div class="post-id">
            <a href="/dars/<%= l._id %>" class="post-title"><%= l.title %></a>
            <div class="post-meta">দারস • <%= l.createdAt ? new Date(l.createdAt).toLocaleDateString('bn-BD') : '' %></div>
          </div>
        </div>
        <div class="post-tags">
          <% if (l.phase === 'abedonpotrer-purbe') { %><span class="badge light">আবেদনপত্রের পূর্বে</span><% } %>
          <% if (l.phase === 'proshnopotrer-purbe') { %><span class="badge light">প্রশ্নপত্রের পূর্বে</span><% } %>
          <% if (l.phase === 'shopother-purbe') { %><span class="badge light">শপথের পূর্বে</span><% } %>
          <% if (l.reference) { %><span class="muted"><%= l.reference %></span><% } %>
        </div>
        <p class="post-text"><%= (l.content || '').substring(0, 220) %>...</p>
        <div class="post-foot">
          <a href="/dars/<%= l._id %>" class="more">বিস্তারিত পড়ুন <svg class="icon sm"><use href="#i-arrow"/></svg></a>
        </div>
      </article>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
