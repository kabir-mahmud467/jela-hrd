<%- include('partials/header', { title: 'দারস' }) %>
<section class="sec-note">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-book"/></svg></span>
    <h2>দারস</h2>
  </div>
  <p class="page-sub">দারসুল কুরআন ও দারসুল হাদিস — ধারা অনুযায়ী। মাসনুন দুআ পড়ুন <a href="/dua">আলাদা বিভাগে</a>।</p>

  <div class="phase-tabs">
    <a href="/dars" class="phase-tab <%= !kind ? 'active' : '' %>">সব ধারা<small>সব দারস একসাথে</small></a>
    <a href="/dars/dhara/darsul-quran" class="phase-tab <%= kind === 'darsul-quran' ? 'active' : '' %>">দারসুল কুরআন<small>ধারা ১</small></a>
    <a href="/dars/dhara/darsul-hadis" class="phase-tab <%= kind === 'darsul-hadis' ? 'active' : '' %>">দারসুল হাদিস<small>ধারা ২</small></a>
  </div>

  <form method="GET" action="/dars" class="search">
    <input type="text" name="q" placeholder="দারস খুঁজুন..." value="<%= q %>" maxlength="100">
    <% if (kind) { %><input type="hidden" name="kind" value="<%= kind %>"><% } %>
    <button type="submit"><svg class="icon sm"><use href="#i-search"/></svg> খুঁজুন</button>
  </form>
  <div class="grid">
    <% if (lessons.length === 0) { %><p class="empty">কোনো দারস পাওয়া যায়নি। অন্য ধারা বা অন্য কিছু লিখে খুঁজুন।</p><% } %>
    <% lessons.forEach(l => { %>
      <div class="card reveal">
        <span class="badge"><%= darsMap[l.kind] || 'দারস' %></span>
        <h3><a href="/dars/<%= l._id %>"><%= l.title %></a></h3>
        <% if (l.reference) { %><p class="muted"><%= l.reference %></p><% } %>
        <p><%= (l.content || '').substring(0, 150) %>...</p>
        <a href="/dars/<%= l._id %>" class="more">বিস্তারিত পড়ুন <svg class="icon sm"><use href="#i-arrow"/></svg></a>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
