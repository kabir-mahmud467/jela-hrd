<%- include('partials/header', { title: item.title }) %>
<a href="/bibidh?cat=<%= item.category %>" class="back"><svg class="icon sm"><use href="#i-back"/></svg> বিবিধ</a>
<article class="detail reveal in">
  <span class="badge"><%= cats[item.category]||item.category %></span>
  <h1><%= item.title %></h1>
  <p style="white-space:pre-line"><%= item.content %></p>
  <% if(item.reference){ %><p class="muted">রেফারেন্স: <%= item.reference %></p><% } %>
</article>
<%- include('partials/footer') %>
