<%- include('partials/header', { title: 'মাসনুন দুআ' }) %>
<% function toBengali(n){ return String(n).split('').map(function(c){ return '০১২৩৪৫৬৭৮৯'[c]||c; }).join(''); } %>
<section class="sec-note">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-star"/></svg></span>
    <h2>মাসনুন দুআ</h2>
  </div>
  <p class="page-sub">দৈনন্দিন জীবনের মাসনুন দুআ — পর্ব অনুযায়ী, আরবি পাঠসহ। শিরোনামে চাপ দিলে নিচে অর্থ খুলবে।</p>

  <div class="chips">
    <a href="/dua" class="chip <%= !phase ? 'active' : '' %>">সব পর্ব</a>
    <% Object.entries(phases).forEach(([val, label]) => { %>
      <a href="/dua/porbo/<%= val %>" class="chip <%= phase === val ? 'active' : '' %>"><%= label %></a>
    <% }) %>
  </div>

  <form method="GET" action="/dua" class="search">
    <input type="text" name="q" placeholder="দুআ খুঁজুন..." value="<%= q %>" maxlength="100">
    <% if (phase) { %><input type="hidden" name="phase" value="<%= phase %>"><% } %>
    <button type="submit"><svg class="icon sm"><use href="#i-search"/></svg> খুঁজুন</button>
  </form>

  <div class="qa-list">
    <% if (!duas || duas.length === 0) { %><p class="empty">কোনো দুআ পাওয়া যায়নি। অন্য পর্ব বা অন্য কিছু লিখে খুঁজুন।</p><% } %>
    <% (duas || []).forEach((d, idx) => { %>
      <div class="qa-item reveal">
        <button class="qa-q" data-toggle-target="dua-<%= idx %>" aria-expanded="false">
          <span><span class="q-no"><%= toBengali(idx+1) %>.</span> <%= d.title %></span>
          <svg class="icon chev"><use href="#i-chev"/></svg>
        </button>
        <div id="dua-<%= idx %>" class="qa-a hidden">
          <div class="ans-meta">
            <% if (d.phase === 'abedonpotrer-purbe') { %><span class="badge light">আবেদনপত্রের পূর্বে</span><% } %>
            <% if (d.phase === 'proshnopotrer-purbe') { %><span class="badge light">প্রশ্নপত্রের পূর্বে</span><% } %>
            <% if (d.phase === 'shopother-purbe') { %><span class="badge light">শপথের পূর্বে</span><% } %>
            <% if (d.reference) { %><span class="muted"><%= d.reference %></span><% } %>
          </div>
          <% if (d.arabic) { %><p class="arabic"><%= d.arabic %></p><% } %>
          <% if (d.transliteration) { %><p class="muted" style="font-style: italic; border-left: 3px solid var(--sky); padding-left: 10px;"><strong>উচ্চারণ:</strong> <%= d.transliteration %></p><% } %>
          <div class="answer-box">
            <strong><svg class="icon sm"><use href="#i-check"/></svg> অর্থ:</strong>
            <div class="content"><%- bnHtml(d.content) %></div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
