<%- include('partials/header', { title: item.title }) %>
<a href="/gurutto" class="back"><svg class="icon sm"><use href="#i-back"/></svg> ফিরে যান</a>
<article class="detail reveal in">
  <span class="badge"><%= item.category %></span>
  <h1><%= item.title %></h1>
  <small class="muted"><svg class="icon sm"><use href="#i-clock"/></svg> <%= item.createdAt ? new Date(item.createdAt).toLocaleDateString('bn-BD') : '' %></small>
  <p class="content"><%= item.description %></p>
  <a href="/gurutto" class="btn"><svg class="icon"><use href="#i-star"/></svg> সব তথ্য দেখুন</a>
</article>
<%- include('partials/footer') %>
