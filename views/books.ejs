<%- include('partials/header', { title: 'বই' }) %>
<% function toBengali(n){ return String(n).split('').map(function(c){ return '০১২৩৪৫৬৭৮৯'[c]||c; }).join(''); } %>
<section class="sec-book">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-book"/></svg></span>
    <h2>বই</h2>
  </div>
  <p class="page-sub">পড়ুন ও ডাউনলোড করুন — পর্ব অনুযায়ী সাজানো।</p>

  <div class="chips">
    <a href="/books" class="chip <%= !phase ? 'active' : '' %>">সব পর্ব</a>
    <% var _seenPhase = {}; var _seenLabel = {}; Object.entries(phases || {}).forEach(([val, label]) => { val = String(val || '').trim(); label = String(label || '').trim(); if (!val || !label || _seenPhase[val] || _seenLabel[label]) return; _seenPhase[val] = 1; _seenLabel[label] = 1; %>
      <a href="/books/phase/<%= val %>" class="chip <%= phase === val ? 'active' : '' %>"><%= label %></a>
    <% }) %>
  </div>

  <form method="GET" action="/books" class="search">
    <input type="text" name="q" placeholder="বই / লেখক খুঁজুন..." value="<%= q %>" maxlength="100">
    <% if (phase) { %><input type="hidden" name="phase" value="<%= phase %>"><% } %>
    <button type="submit"><svg class="icon sm"><use href="#i-search"/></svg> খুঁজুন</button>
  </form>
  <div class="qa-list">
    <% if (books.length === 0) { %><p class="empty">কোনো বই পাওয়া যায়নি। অন্য পর্ব বা অন্য কিছু লিখে খুঁজুন।</p><% } %>
    <% books.forEach((b, idx) => { %>
      <div class="qa-item reveal">
        <button class="qa-q" data-toggle-target="book-<%= idx %>" aria-expanded="false">
          <span><span class="q-no"><%= toBengali(idx+1) %>.</span> <%= b.title %></span>
          <svg class="icon chev"><use href="#i-chev"/></svg>
        </button>
        <div id="book-<%= idx %>" class="qa-a hidden">
          <div class="ans-meta">
            <span class="muted"><svg class="icon sm"><use href="#i-pen"/></svg> <%= b.author || 'লেখক অজানা' %></span>
            <% if (b.phase === 'abedonpotrer-purbe') { %><span class="badge light">আবেদনপত্রের পূর্বে</span><% } %>
            <% if (b.phase === 'proshnopotrer-purbe') { %><span class="badge light">প্রশ্নপত্রের পূর্বে</span><% } %>
            <% if (b.phase === 'shopother-purbe') { %><span class="badge light">শপথের পূর্বে</span><% } %>
          </div>
          <% if (b.link && (b.link.startsWith('http://') || b.link.startsWith('https://'))) { %>
          <div style="margin-top:10px">
            <a href="<%= b.link %>" target="_blank" rel="noopener" class="btn small primary"><svg class="icon sm"><use href="#i-download"/></svg> পড়ুন / ডাউনলোড</a>
          </div>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
