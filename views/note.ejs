<%- include('partials/header', { title: 'নোট' }) %>
<% function toBengali(n){ return String(n).split('').map(function(c){ return '০১২৩৪৫৬৭৮৯'[c]||c; }).join(''); } %>
<section class="sec-note">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-note"/></svg></span>
    <h2>নোট</h2>
  </div>
  <p class="page-sub">আলোচনা নোট ও বই নোট — নিচের ড্রপডাউন থেকে ধরন নির্বাচন করুন। শিরোনামে চাপ দিলে নিচে বিস্তারিত খুলবে।</p>

  <form method="GET" action="/note" class="form" style="flex-direction:row;gap:8px;align-items:center;flex-wrap:wrap">
    <label for="note-cat" style="font-weight:700">ধরন নির্বাচন:</label>
    <select id="note-cat" name="cat" style="min-width:220px">
      <% Object.entries(cats).forEach(([val,label])=>{ %>
        <option value="<%= val %>" <%= cat===val ? 'selected' : '' %>><%= label %></option>
      <% }) %>
    </select>
    <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
    <% if (phase) { %><input type="hidden" name="phase" value="<%= phase %>"><% } %>
    <button type="submit" class="btn small">দেখুন</button>
  </form>

  <div class="chips" style="margin-top:12px">
    <a href="/note<%= cat && cat !== 'alochona' ? '?cat='+cat : '' %>" class="chip <%= !phase ? 'active' : '' %>">সব পর্ব</a>
    <a href="/note/phase/abedonpotrer-purbe<%= cat && cat !== 'alochona' ? '?cat='+cat : '' %>" class="chip <%= phase === 'abedonpotrer-purbe' ? 'active' : '' %>">আবেদনপত্রের পূর্বে</a>
    <a href="/note/phase/proshnopotrer-purbe<%= cat && cat !== 'alochona' ? '?cat='+cat : '' %>" class="chip <%= phase === 'proshnopotrer-purbe' ? 'active' : '' %>">প্রশ্নপত্রের পূর্বে</a>
  </div>

  <form method="GET" action="/note" class="search">
    <input type="text" name="q" placeholder="নোট খুঁজুন..." value="<%= q %>" maxlength="100">
    <input type="hidden" name="cat" value="<%= cat %>">
    <% if (phase) { %><input type="hidden" name="phase" value="<%= phase %>"><% } %>
    <button type="submit"><svg class="icon sm"><use href="#i-search"/></svg> খুঁজুন</button>
  </form>

  <div class="qa-list">
    <% if (!notes || notes.length === 0) { %><p class="empty">কোনো নোট পাওয়া যায়নি। অন্য ধরন, পর্ব বা অন্য কিছু লিখে খুঁজুন।</p><% } %>
    <% (notes || []).forEach((n, idx) => { %>
      <div class="qa-item reveal">
        <button class="qa-q" data-toggle-target="note-<%= idx %>" aria-expanded="false">
          <span><span class="q-no"><%= toBengali(idx+1) %>.</span> <%= n.title %></span>
          <svg class="icon chev"><use href="#i-chev"/></svg>
        </button>
        <div id="note-<%= idx %>" class="qa-a hidden">
          <div class="ans-meta">
            <% if (n.phase === 'abedonpotrer-purbe') { %><span class="badge light">আবেদনপত্রের পূর্বে</span><% } %>
            <% if (n.phase === 'proshnopotrer-purbe') { %><span class="badge light">প্রশ্নপত্রের পূর্বে</span><% } %>
            <% if (n.createdAt) { %><span class="muted"><%= new Date(n.createdAt).toLocaleDateString('bn-BD') %></span><% } %>
          </div>
          <div class="content"><%- bnHtml(n.content) %></div>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
