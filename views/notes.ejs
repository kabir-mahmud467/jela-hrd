<%- include('partials/header', { title: 'আলোচনা নোট' }) %>
<section class="sec-note">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-note"/></svg></span>
    <h2>আলোচনা নোট</h2>
  </div>
  <p class="page-sub">বিস্তারিত আলোচনা ও ব্যাখ্যাসহ নোট — পর্ব অনুযায়ী।</p>

  <div class="phase-tabs">
    <a href="/notes" class="phase-tab <%= !phase ? 'active' : '' %>">সব পর্ব<small>সব নোট একসাথে</small></a>
    <a href="/notes/phase/abedonpotrer-purbe" class="phase-tab <%= phase === 'abedonpotrer-purbe' ? 'active' : '' %>">আবেদনপত্রের পূর্বে<small>পর্ব ১</small></a>
    <a href="/notes/phase/proshnopotrer-purbe" class="phase-tab <%= phase === 'proshnopotrer-purbe' ? 'active' : '' %>">প্রশ্নপত্রের পূর্বে<small>পর্ব ২</small></a>
  </div>
  <div class="phase-tabs">
    <a href="/notes/phase/shopother-purbe" class="phase-tab <%= phase === 'shopother-purbe' ? 'active' : '' %>">শপথের পূর্বে<small>পর্ব ৩</small></a>
    <a href="/questions" class="phase-tab">প্রশ্নোত্তর<small>পর্ব অনুযায়ী প্রশ্ন</small></a>
    <a href="/books" class="phase-tab">বই<small>পর্ব অনুযায়ী বই</small></a>
  </div>

  <form method="GET" action="/notes" class="search">
    <input type="text" name="q" placeholder="নোট খুঁজুন..." value="<%= q %>" maxlength="100">
    <% if (phase) { %><input type="hidden" name="phase" value="<%= phase %>"><% } %>
    <button type="submit"><svg class="icon sm"><use href="#i-search"/></svg> খুঁজুন</button>
  </form>
  <div class="grid">
    <% if (notes.length === 0) { %><p class="empty">কোনো নোট পাওয়া যায়নি। অন্য পর্ব বা অন্য কিছু লিখে খুঁজুন।</p><% } %>
    <% notes.forEach(n => { %>
      <div class="card reveal">
        <span class="badge"><%= n.subject || 'নোট' %></span>
        <% if (n.phase === 'abedonpotrer-purbe') { %><span class="badge light">আবেদনপত্রের পূর্বে</span><% } %>
        <% if (n.phase === 'proshnopotrer-purbe') { %><span class="badge light">প্রশ্নপত্রের পূর্বে</span><% } %>
        <% if (n.phase === 'shopother-purbe') { %><span class="badge light">শপথের পূর্বে</span><% } %>
        <h3><a href="/notes/<%= n._id %>"><%= n.title %></a></h3>
        <p><%= (n.content || '').substring(0, 150) %>...</p>
        <a href="/notes/<%= n._id %>" class="more">বিস্তারিত পড়ুন <svg class="icon sm"><use href="#i-arrow"/></svg></a>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
