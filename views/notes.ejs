<%- include('partials/header', { title: 'আলোচনা নোট' }) %>
<section class="sec-note">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-note"/></svg></span>
    <h2>আলোচনা নোট</h2>
  </div>
  <p class="page-sub">বিস্তারিত আলোচনা ও ব্যাখ্যাসহ নোট — পর্ব অনুযায়ী।</p>

  <div class="chips">
    <a href="/notes" class="chip <%= !phase ? 'active' : '' %>">সব পর্ব</a>
    <a href="/notes/phase/abedonpotrer-purbe" class="chip <%= phase === 'abedonpotrer-purbe' ? 'active' : '' %>">আবেদনপত্রের পূর্বে</a>
    <a href="/notes/phase/proshnopotrer-purbe" class="chip <%= phase === 'proshnopotrer-purbe' ? 'active' : '' %>">প্রশ্নপত্রের পূর্বে</a>
    <a href="/notes/phase/shopother-purbe" class="chip <%= phase === 'shopother-purbe' ? 'active' : '' %>">শপথের পূর্বে</a>
  </div>

  <form method="GET" action="/notes" class="search">
    <input type="text" name="q" placeholder="নোট খুঁজুন..." value="<%= q %>" maxlength="100">
    <% if (phase) { %><input type="hidden" name="phase" value="<%= phase %>"><% } %>
    <button type="submit"><svg class="icon sm"><use href="#i-search"/></svg> খুঁজুন</button>
  </form>
  <div class="feed">
    <% if (notes.length === 0) { %><p class="empty">কোনো নোট পাওয়া যায়নি। অন্য পর্ব বা অন্য কিছু লিখে খুঁজুন।</p><% } %>
    <% notes.forEach((n, idx) => { %>
      <article class="card social reveal">
        <div class="post-head">
          <span class="avatar av<%= (idx % 3) + 1 %>"><%= (n.title || 'ন').charAt(0) %></span>
          <div class="post-id">
            <a href="/notes/<%= n._id %>" class="post-title"><%= n.title %></a>
            <div class="post-meta"><%= n.subject || 'নোট' %> • <%= n.createdAt ? new Date(n.createdAt).toLocaleDateString('bn-BD') : '' %></div>
          </div>
        </div>
        <div class="post-tags">
          <% if (n.phase === 'abedonpotrer-purbe') { %><span class="badge light">আবেদনপত্রের পূর্বে</span><% } %>
          <% if (n.phase === 'proshnopotrer-purbe') { %><span class="badge light">প্রশ্নপত্রের পূর্বে</span><% } %>
          <% if (n.phase === 'shopother-purbe') { %><span class="badge light">শপথের পূর্বে</span><% } %>
        </div>
        <p class="post-text"><%= (n.content || '').substring(0, 220) %>...</p>
        <div class="post-foot">
          <a href="/notes/<%= n._id %>" class="more">বিস্তারিত পড়ুন <svg class="icon sm"><use href="#i-arrow"/></svg></a>
        </div>
      </article>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
