<%- include('partials/header', { title: 'বিবিধ' }) %>
<section class="sec-note">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-book"/></svg></span>
    <h2>বিবিধ</h2>
  </div>
  <p class="page-sub">বিভিন্ন বিষয় — নিচের ড্রপডাউন থেকে বিষয় নির্বাচন করুন। ডিফল্ট: <b>ইলমূল কুরআন</b>।</p>

  <form method="GET" action="/bibidh" class="form" style="flex-direction:row;gap:8px;align-items:center;flex-wrap:wrap">
    <label for="bibidh-cat" style="font-weight:700">বিষয় নির্বাচন:</label>
    <select id="bibidh-cat" name="cat" style="min-width:220px">
      <% Object.entries(cats).forEach(([val,label])=>{ %>
        <option value="<%= val %>" <%= cat===val ? 'selected' : '' %>><%= label %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn small">দেখুন</button>
  </form>

  <% if(cat==='samprotik-proshno'){ %>
    <div class="chips" style="margin-top:8px">
      <a href="/bibidh?cat=samprotik-proshno" class="chip <%= !phase ? 'active' : '' %>">সব পর্ব</a>
      <% samprotikPhases.forEach(function(ph){ %>
        <a href="/bibidh?cat=samprotik-proshno&phase=<%= ph %>" class="chip <%= phase===ph ? 'active' : '' %>"><%= phases[ph] %></a>
      <% }) %>
    </div>
    <p class="muted" style="margin-top:4px">এটি নির্বাচনের জন্য — সাম্প্রতিক প্রশ্ন ৩ পর্বে ভাগ।</p>
  <% } %>

  <form method="GET" action="/bibidh" class="search" style="margin-top:12px">
    <input type="text" name="q" placeholder="বিবিধ খুঁজুন..." value="<%= q %>" maxlength="100">
    <input type="hidden" name="cat" value="<%= cat %>">
    <% if(phase){ %><input type="hidden" name="phase" value="<%= phase %>"><% } %>
    <button type="submit"><svg class="icon sm"><use href="#i-search"/></svg> খুঁজুন</button>
  </form>

  <div class="qa-list" style="margin-top:12px">
    <% if(!items || items.length===0){ %><p class="empty">কোনো তথ্য পাওয়া যায়নি।</p><% } %>
    <% (items||[]).forEach(function(it,idx){ %>
      <div class="qa-item reveal">
        <button class="qa-q" data-toggle-target="bibidh-<%= idx %>" aria-expanded="false">
          <span><span class="q-no"><%= idx+1 %>.</span> <%= it.title %></span>
          <svg class="icon chev"><use href="#i-chev"/></svg>
        </button>
        <div id="bibidh-<%= idx %>" class="qa-a hidden">
          <div class="ans-meta">
            <span class="badge"><%= cats[it.category]||it.category %></span>
            <% if(it.phase==='abedonpotrer-purbe'){ %><span class="badge light">আবেদনপত্রের পূর্বে</span><% } %>
            <% if(it.phase==='proshnopotrer-purbe'){ %><span class="badge light">প্রশ্নপত্রের পূর্বে</span><% } %>
            <% if(it.phase==='shopother-purbe'){ %><span class="badge light">শপথের পূর্বে</span><% } %>
            <% if(it.reference){ %><span class="muted"><%= it.reference %></span><% } %>
          </div>
          <p style="white-space:pre-line"><%= it.content %></p>
          <a href="/bibidh/<%= it._id %>" class="more">স্থায়ী লিংক <svg class="icon sm"><use href="#i-arrow"/></svg></a>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
