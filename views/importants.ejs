<%- include('partials/header', { title: 'গুরুত্বপূর্ণ তথ্য' }) %>
<section class="sec-star">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-star"/></svg></span>
    <h2>গুরুত্বপূর্ণ তথ্য</h2>
  </div>
  <p class="page-sub">জরুরি নোটিশ ও আপডেট সবার আগে।</p>
  <div class="grid">
    <% if (importants.length === 0) { %><p class="empty">কোনো তথ্য পাওয়া যায়নি।</p><% } %>
    <% importants.forEach(i => { %>
      <div class="card reveal <%= i.isPinned ? 'pinned' : '' %>">
        <% if (i.isPinned) { %><span class="badge pin"><svg class="icon sm"><use href="#i-pin"/></svg> পিনড</span><% } %>
        <span class="badge"><%= i.category %></span>
        <h3><a href="/gurutto/<%= i._id %>"><%= i.title %></a></h3>
        <p><%= (i.description || '').substring(0, 200) %></p>
        <small class="muted"><svg class="icon sm"><use href="#i-clock"/></svg> <%= i.createdAt ? new Date(i.createdAt).toLocaleDateString('bn-BD') : '' %></small>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
