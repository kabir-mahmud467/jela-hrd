<!DOCTYPE html>
<html lang="bn">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>বই ফর্ম | Admin</title><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include('../partials/icons') %>

<header class="navbar admin-nav" id="navbar"><div class="container nav-inner"><a href="/admin" class="logo"><svg class="icon"><use href="#i-gear"/></svg> Admin</a><nav id="mainnav"><a href="/admin/books">তালিকা</a></nav></div></header>
<main class="container">
<h1><%= item && item._id ? 'এডিট' : 'নতুন' %> বই</h1>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<form method="POST" action="<%= item && item._id ? '/admin/books/' + item._id : '/admin/books' %>" class="form">
<label>বইয়ের নাম</label><input name="title" value="<%= item.title || '' %>" required>
<label>লেখক</label><input name="author" value="<%= item.author || '' %>">
<label>লিংক (PDF/Drive)</label><input name="link" value="<%= item.link || '' %>" required placeholder="https://...">
<label>ক্যাটাগরি</label><input name="category" value="<%= item.category || 'সাধারণ' %>">
<label>বিবরণ</label><textarea name="description" rows="3"><%= item.description || '' %></textarea>
<button class="btn primary" type="submit">সেভ করুন</button>
</form></main><script src="/js/main.js"></script>
</body></html>
