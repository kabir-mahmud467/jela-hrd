<!DOCTYPE html>
<html lang="bn">
<head>
<title>নোট | Admin</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('../partials/icons') %>
<%- include('partials/nav', { active: 'notes', admin: typeof admin !== 'undefined' ? admin : null }) %>
<main class="container admin-main">
<div class="sec-head">
  <span class="sec-ico"><svg class="icon"><use href="#i-note"/></svg></span>
  <h2>নোট তালিকা</h2>
  <a href="/admin/notes/new" class="btn primary small">+ নতুন</a>
</div>
<div class="bulk-bar" data-bulk-bar hidden><span class="bulk-count" data-bulk-count></span><button type="button" class="btn small danger" data-bulk-delete>সিলেক্ট করা ডিলিট</button></div>
<div class="table-wrap"><table class="table" data-reorder="notes"><tr><th class="bulk-col"><input type="checkbox" class="bulk-all" data-bulk-all title="সব সিলেক্ট"></th><th>শিরোনাম</th><th>ধরন</th><th>পর্ব</th><th>অ্যাকশন</th></tr>
<% items.forEach((i, idx) => { %><tr data-id="<%= i._id %>"><td><input type="checkbox" class="bulk-check" value="<%= i._id %>" aria-label="সিলেক্ট"></td><td><%= i.title %></td><td><%= i.category === 'boi' ? 'বই নোট' : 'আলোচনা নোট' %></td><td><%= i.phase === 'proshnopotrer-purbe' ? 'প্রশ্নপত্রের পূর্বে' : 'আবেদনপত্রের পূর্বে' %></td>
<td><div class="table-actions"><a href="/admin/notes/<%= i._id %>/edit" class="btn small">এডিট</a>
<form method="POST" action="/admin/notes/<%= i._id %>/delete" class="inline-form" data-confirm="ডিলিট করবেন?"><button class="btn small danger" type="submit">ডিলিট</button></form><span class="move-col"><form method="POST" action="/admin/notes/<%= i._id %>/move/up" class="inline-form"><button class="btn small move-btn" type="submit" title="উপরে তুলুন"<%= idx === 0 ? ' disabled' : '' %>>▲</button></form><form method="POST" action="/admin/notes/<%= i._id %>/move/down" class="inline-form"><button class="btn small move-btn" type="submit" title="নিচে নামান"<%= idx === items.length - 1 ? ' disabled' : '' %>>▼</button></form></span></div></td></tr><% }) %>
</table></div>
</main>
<%- include('partials/foot') %>
