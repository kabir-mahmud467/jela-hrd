<!DOCTYPE html>
<html lang="bn">
<head>
<title><%= isNew ? 'নতুন ইউজার' : 'ইউজার এডিট' %> | এইচআরডি নারায়ণগঞ্জ জেলা Admin</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav', { active: 'users', admin }) %>
<main class="container admin-main">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-key"/></svg></span>
    <h2><%= isNew ? 'নতুন ইউজার' : 'ইউজার এডিট' %></h2>
  </div>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="POST" action="<%= isNew ? '/admin/users' : '/admin/users/' + item._id %>" class="form" style="max-width:520px">
    <label for="username">ইউজারনেম (লগিন)</label>
    <input id="username" type="text" name="username" required maxlength="30" placeholder="যেমন: rahim_01" value="<%= (item && item.username) || '' %>" autocomplete="username">
    <label for="name">নাম</label>
    <input id="name" type="text" name="name" required maxlength="100" placeholder="পুরো নাম" value="<%= (item && item.name) || '' %>" autocomplete="name">
    <label for="phone">ফোন</label>
    <input id="phone" type="tel" name="phone" maxlength="20" placeholder="01XXXXXXXXX" value="<%= (item && item.phone) || '' %>" autocomplete="tel" inputmode="tel">
    <label for="password">পাসওয়ার্ড<%= isNew ? '' : ' (খালি রাখলে আগেরটাই থাকবে)' %></label>
    <input id="password" type="password" name="password" <%= isNew ? 'required' : '' %> maxlength="200" placeholder="<%= isNew ? 'কমপক্ষে ৪ অক্ষর' : 'বদলাতে চাইলে নতুন দিন' %>" autocomplete="new-password">
    <div class="form-actions"><button type="submit" class="btn primary"><%= isNew ? 'ইউজার তৈরি করুন' : 'সেভ করুন' %></button><a href="/admin/users" class="btn">বাতিল</a></div>
  </form>
</main>
<%- include('partials/foot') %>
