<!DOCTYPE html>
<html lang="bn">
<head>
<title>গুরুত্বপূর্ণ ফর্ম | Admin</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('../partials/icons') %>
<%- include('partials/nav', { active: 'importants', admin: typeof admin !== 'undefined' ? admin : null }) %>
<main class="container admin-main">
<div class="sec-head">
  <span class="sec-ico"><svg class="icon"><use href="#i-star"/></svg></span>
  <h2><%= item && item._id ? 'এডিট' : 'নতুন' %> গুরুত্বপূর্ণ তথ্য</h2>
  <a href="/admin/importants" class="btn small">তালিকা</a>
</div>
<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
<form method="POST" action="<%= item && item._id ? '/admin/importants/' + item._id : '/admin/importants' %>" class="form">
<label for="f-title">শিরোনাম</label><input id="f-title" name="title" value="<%= item.title || '' %>" required maxlength="300">
<label for="f-category">ক্যাটাগরি</label><input id="f-category" name="category" value="<%= item.category || 'সাধারণ' %>" maxlength="100">
<label for="f-desc">বিবরণ</label><textarea id="f-desc" name="description" rows="5" required maxlength="5000"><%= item.description || '' %></textarea>
<label class="check"><input type="checkbox" name="isPinned" <%= item.isPinned ? 'checked' : '' %>> পিন করে রাখুন (উপরে দেখাবে)</label>
<div class="form-actions"><button class="btn primary" type="submit">সেভ করুন</button><a href="/admin/importants" class="btn">বাতিল</a></div>
</form>
</main>
<%- include('partials/foot') %>
