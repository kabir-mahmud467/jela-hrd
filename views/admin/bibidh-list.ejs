<!DOCTYPE html>
<html lang="bn">
<head>
<title>বিবিধ | Admin</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('../partials/icons') %>
<%- include('partials/nav', { active: 'bibidh', admin: typeof admin !== 'undefined' ? admin : null }) %>
<main class="container admin-main">
<div class="sec-head">
  <span class="sec-ico"><svg class="icon"><use href="#i-book"/></svg></span>
  <h2>বিবিধ তালিকা</h2>
  <a href="/admin/bibidh/new" class="btn primary small">+ নতুন</a>
</div>
<div class="table-wrap"><table class="table"><tr><th>শিরোনাম</th><th>বিষয়</th><th>অ্যাকশন</th></tr>
<% (items || []).forEach((i, idx) => { %><tr><td><%= i.title %></td><td><%= i.category || '' %></td>
<td><div class="table-actions"><a href="/admin/bibidh/<%= i._id %>/edit" class="btn small">এডিট</a>
<form method="POST" action="/admin/bibidh/<%= i._id %>/delete" class="inline-form" data-confirm="ডিলিট করবেন?"><button class="btn small danger" type="submit">ডিলিট</button></form><span class="move-col"><form method="POST" action="/admin/bibidh/<%= i._id %>/move/up" class="inline-form"><button class="btn small move-btn" type="submit" title="উপরে তুলুন"<%= idx === 0 ? ' disabled' : '' %>>▲</button></form><form method="POST" action="/admin/bibidh/<%= i._id %>/move/down" class="inline-form"><button class="btn small move-btn" type="submit" title="নিচে নামান"<%= idx === (items || []).length - 1 ? ' disabled' : '' %>>▼</button></form></span></div></td></tr><% }) %>
</table></div>
</main>
<%- include('partials/foot') %>
