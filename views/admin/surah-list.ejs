<!DOCTYPE html>
<html lang="bn">
<head>
<title>সূরা | Admin</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('../partials/icons') %>
<%- include('partials/nav', { active: 'surah', admin: typeof admin !== 'undefined' ? admin : null }) %>
<main class="container admin-main">
<div class="sec-head">
  <span class="sec-ico"><svg class="icon"><use href="#i-book"/></svg></span>
  <h2>সূরা তালিকা</h2>
  <a href="/admin/surah/new" class="btn primary small">+ নতুন</a>
</div>
<div class="table-wrap"><table class="table"><tr><th>নাম</th><th>পর্ব</th><th>অ্যাকশন</th></tr>
<% items.forEach(i=>{ %><tr><td><%= i.title %></td><td><%= i.phase==='proshnopotrer-purbe' ? 'প্রশ্নপত্রের পূর্বে' : i.phase==='shopother-purbe' ? 'শপথের পূর্বে' : 'আবেদনপত্রের পূর্বে' %></td>
<td><div class="table-actions"><a href="/admin/surah/<%= i._id %>/edit" class="btn small">এডিট</a>
<form method="POST" action="/admin/surah/<%= i._id %>/delete" class="inline-form" data-confirm="ডিলিট করবেন?"><button class="btn small danger" type="submit">ডিলিট</button></form></div></td></tr><% }) %>
</table></div>
</main>
<%- include('partials/foot') %>
