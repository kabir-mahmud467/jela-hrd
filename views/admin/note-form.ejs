<!DOCTYPE html>
<html lang="bn">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>নোট ফর্ম | Admin</title><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include('../partials/icons') %>

<header class="navbar admin-nav" id="navbar"><div class="container nav-inner"><a href="/admin" class="logo"><svg class="icon"><use href="#i-gear"/></svg> Admin</a><nav id="mainnav"><a href="/admin/notes">তালিকা</a></nav></div></header>
<main class="container">
<h1><%= item && item._id ? 'এডিট' : 'নতুন' %> আলোচনা নোট</h1>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<form method="POST" action="<%= item && item._id ? '/admin/notes/' + item._id : '/admin/notes' %>" class="form">
<label>শিরোনাম</label><input name="title" value="<%= item.title || '' %>" required>
<label>বিষয়</label><input name="subject" value="<%= item.subject || 'সাধারণ' %>">
<label>পর্ব *</label><select name="phase">
  <option value="abedonpotrer-purbe" <%= (!item.phase || item.phase === 'abedonpotrer-purbe') ? 'selected' : '' %>>আবেদনপত্রের পূর্বে</option>
  <option value="proshnopotrer-purbe" <%= item.phase === 'proshnopotrer-purbe' ? 'selected' : '' %>>প্রশ্নপত্রের পূর্বে</option>
  <option value="shopother-purbe" <%= item.phase === 'shopother-purbe' ? 'selected' : '' %>>শপথের পূর্বে</option>
</select>
<label>বিস্তারিত</label><textarea name="content" rows="8" required><%= item.content || '' %></textarea>
<button class="btn primary" type="submit">সেভ করুন</button>
</form></main><script src="/js/main.js"></script>
</body></html>
