<!DOCTYPE html>
<html lang="bn">
<head>
<title>ড্যাশবোর্ড | জেলা HRD Admin</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav', { active: 'dashboard', admin }) %>
<main class="container admin-main">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-layers"/></svg></span>
    <h2>স্বাগতম, <%= admin.username %>!</h2>
    <span class="badge light">DB: <%= sys.db %></span>
    <a href="/admin/security" class="btn small">সিকিউরিটি সেন্টার</a>
  </div>

  <div class="toolbar">
    <form method="GET" action="/admin/search" class="search" role="search">
      <input name="q" value="" maxlength="100" placeholder="সব কনটেন্টে খুঁজুন (বই/নোট/দারস/দুআ/আয়াত/সূরা/বিবিধ)…" aria-label="সার্চ">
      <button type="submit"><svg class="icon sm"><use href="#i-search"/></svg> খুঁজুন</button>
    </form>
    <span class="count badge light">মোট কনটেন্ট: <%= counts.book + counts.note + counts.dars + counts.dua + counts.ayatHadith + counts.surah + counts.bibidh %></span>
  </div>

  <div class="admin-grid">
    <div class="card stat a-emerald"><h2><%= counts.book %></h2><p>বই লিংক</p><div class="stat-actions"><a href="/admin/books" class="btn small">পরিচালনা</a><a href="/admin/books/new" class="btn small primary">+ নতুন</a></div></div>
    <div class="card stat a-violet"><h2><%= counts.note %></h2><p>নোট</p><div class="stat-actions"><a href="/admin/notes" class="btn small">পরিচালনা</a><a href="/admin/notes/new" class="btn small primary">+ নতুন</a></div></div>
    <div class="card stat a-emerald"><h2><%= counts.dars %></h2><p>দারস</p><div class="stat-actions"><a href="/admin/dars" class="btn small">পরিচালনা</a><a href="/admin/dars/new" class="btn small primary">+ নতুন</a></div></div>
    <div class="card stat a-sky"><h2><%= counts.dua %></h2><p>মাসনুন দুআ</p><div class="stat-actions"><a href="/admin/duas" class="btn small">পরিচালনা</a><a href="/admin/duas/new" class="btn small primary">+ নতুন</a></div></div>
    <div class="card stat a-violet"><h2><%= counts.ayatHadith %></h2><p>আয়াত-হাদিস</p><div class="stat-actions"><a href="/admin/ayathadith" class="btn small">পরিচালনা</a><a href="/admin/ayathadith/new" class="btn small primary">+ নতুন</a></div></div>
    <div class="card stat a-emerald"><h2><%= counts.surah %></h2><p>সূরা</p><div class="stat-actions"><a href="/admin/surah" class="btn small">পরিচালনা</a><a href="/admin/surah/new" class="btn small primary">+ নতুন</a></div></div>
    <div class="card stat a-sky"><h2><%= counts.bibidh %></h2><p>বিবিধ</p><div class="stat-actions"><a href="/admin/bibidh" class="btn small">পরিচালনা</a><a href="/admin/bibidh/new" class="btn small primary">+ নতুন</a></div></div>
    <div class="card stat"><h2><%= counts.ban %></h2><p>ব্যানড IP</p><div class="stat-actions"><a href="/admin/bans" class="btn small">পরিচালনা</a><a href="/admin/security" class="btn small primary">আক্রমণ দেখুন</a></div></div>
    <div class="card stat"><h2><%= events24h %></h2><p>সন্দেহজনক ঘটনা (২৪ঘ)</p><div class="stat-actions"><a href="/admin/security" class="btn small">বিস্তারিত</a><a href="/admin/export/security" class="btn small primary">এক্সপোর্ট</a></div></div>
  </div>

  <div class="admin-panels mt-16">
    <div class="panel">
      <h3><svg class="icon sm"><use href="#i-clock"/></svg> সাম্প্রতিক কনটেন্ট</h3>
      <% if ((recent || []).length === 0) { %><p class="muted">এখনো কোনো কনটেন্ট নেই — উপরের “+ নতুন” থেকে যোগ করুন।</p><% } %>
      <ul class="recent-list">
        <% (recent || []).forEach(r => { %>
          <li>
            <span class="badge light"><%= r.type %></span>
            <a class="title" href="<%= r.adminUrl %>"><%= (r.title || '').substring(0, 70) %></a>
            <span class="muted"><%= r.when ? new Date(r.when).toLocaleDateString('bn-BD') : '' %></span>
          </li>
        <% }) %>
      </ul>
      <div class="quick-actions mt-16">
        <a href="/admin/books/new" class="btn small primary">+ বই</a>
        <a href="/admin/notes/new" class="btn small">+ নোট</a>
        <a href="/admin/dars/new" class="btn small">+ দারস</a>
        <a href="/admin/duas/new" class="btn small">+ দুআ</a>
        <a href="/admin/ayathadith/new" class="btn small">+ আয়াত-হাদিস</a>
        <a href="/admin/surah/new" class="btn small">+ সূরা</a>
        <a href="/admin/bibidh/new" class="btn small">+ বিবিধ</a>
      </div>
    </div>
    <div>
      <div class="panel">
        <h3><svg class="icon sm"><use href="#i-lock"/></svg> লাইভ আক্রমণ (১৫ মিনিট) <span class="badge"><%= (topIps || []).length %> IP</span></h3>
        <% if ((topIps || []).length === 0) { %><p class="muted">এই মুহূর্তে অস্বাভাবিক ট্রাফিক নেই।</p><% } %>
        <ul class="recent-list">
          <% (topIps || []).slice(0, 5).forEach(t => { %>
            <li>
              <span class="ip-pill"><%= t.ip %></span>
              <span class="badge light"><%= t.count %> req</span>
              <form method="POST" action="/admin/bans" class="inline-form" data-confirm="<%= t.ip %> ব্যান করবেন?">
                <input type="hidden" name="ip" value="<%= t.ip %>">
                <input type="hidden" name="reason" value="সিকিউরিটি সেন্টার থেকে — অস্বাভাবিক রিকোয়েস্ট">
                <button class="btn small danger" type="submit">ব্যান</button>
              </form>
            </li>
          <% }) %>
        </ul>
        <p><a href="/admin/security" class="more">সব IP দেখুন <svg class="icon sm"><use href="#i-arrow"/></svg></a></p>
      </div>
      <div class="panel mt-16">
        <h3><svg class="icon sm"><use href="#i-gear"/></svg> সিস্টেম</h3>
        <p class="muted">আপটাইম: <b><%= sys.uptime %></b> · মেমরি: <b><%= sys.mem %></b><br>Node: <b><%= sys.node %></b> · Asset: <code>v<%= String(assetVer).slice(0, 24) %>…</code></p>
        <p class="muted">CSS বদলে দেখা না গেলে: hard-refresh (Ctrl+Shift+R) করুন — সব CSS/JS এখন <code>?v=</code> সহ লোড হয়।</p>
        <div class="quick-actions">
          <a href="/admin/export/all" class="btn small">ব্যাকআপ (JSON)</a>
          <a href="/admin/settings" class="btn small">লগিন পরিবর্তন</a>
          <a href="/" class="btn small">সাইট দেখুন</a>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('partials/foot') %>
