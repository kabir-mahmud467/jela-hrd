<!DOCTYPE html>
<html lang="bn">
<head>
<title>প্রশ্ন ফর্ম | Admin</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('../partials/icons') %>
<%- include('partials/nav', { active: 'questions', admin: typeof admin !== 'undefined' ? admin : null }) %>
<main class="container admin-main">
<div class="sec-head">
  <span class="sec-ico"><svg class="icon"><use href="#i-help"/></svg></span>
  <h2><%= item && item._id ? 'এডিট' : 'নতুন' %> প্রশ্ন</h2>
  <a href="/admin/questions" class="btn small">তালিকা</a>
</div>
<p class="page-sub">উত্তর পাবলিক পেজে ক্লিক করলে দেখাবে।</p>
<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
<form method="POST" action="<%= item && item._id ? '/admin/questions/' + item._id : '/admin/questions' %>" class="form">
<label for="f-q">প্রশ্ন *</label><textarea id="f-q" name="question" rows="2" required maxlength="500"><%= item.question || '' %></textarea>
<label for="f-a">উত্তর * (ক্লিক করলে দেখাবে)</label><textarea id="f-a" name="answer" rows="4" required maxlength="5000"><%= item.answer || '' %></textarea>
<label for="f-subject">বিষয়</label><input id="f-subject" name="subject" value="<%= item.subject || 'সাধারণ' %>" maxlength="100">
<label for="f-chapter">অধ্যায়</label><input id="f-chapter" name="chapter" value="<%= item.chapter || '' %>" maxlength="100">
<label for="f-phase">পর্ব *</label><select id="f-phase" name="phase">
  <option value="abedonpotrer-purbe" <%= (!item.phase || item.phase === 'abedonpotrer-purbe') ? 'selected' : '' %>>আবেদনপত্রের পূর্বে</option>
  <option value="proshnopotrer-purbe" <%= item.phase === 'proshnopotrer-purbe' ? 'selected' : '' %>>প্রশ্নপত্রের পূর্বে</option>
  <option value="shopother-purbe" <%= item.phase === 'shopother-purbe' ? 'selected' : '' %>>শপথের পূর্বে</option>
</select>
<div class="form-actions"><button class="btn primary" type="submit">সেভ করুন</button><a href="/admin/questions" class="btn">বাতিল</a></div>
</form>
</main>
<%- include('partials/foot') %>
