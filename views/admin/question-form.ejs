<!DOCTYPE html>
<html lang="bn">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>প্রশ্ন ফর্ম | Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVer !== 'undefined' ? assetVer : '1' %>"></head>
<body>
<%- include('../partials/icons') %>
<header class="navbar admin-nav" id="navbar"><div class="container nav-inner"><a href="/admin" class="logo"><svg class="icon"><use href="#i-gear"/></svg> Admin</a><button class="nav-toggle" id="navToggle" aria-label="menu" aria-expanded="false"><span></span><span></span><span></span></button><nav id="mainnav"><a href="/admin/questions">তালিকা</a></nav></div></header>
<main class="container">
<h1 class="page-title"><svg class="icon"><use href="#i-help"/></svg> <%= item && item._id ? 'এডিট' : 'নতুন' %> প্রশ্ন</h1>
<p class="page-sub">উত্তর পাবলিক পেজে ক্লিক করলে দেখাবে।</p>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<form method="POST" action="<%= item && item._id ? '/admin/questions/' + item._id : '/admin/questions' %>" class="form">
<label>প্রশ্ন *</label><textarea name="question" rows="2" required maxlength="500"><%= item.question || '' %></textarea>
<label>উত্তর * (ক্লিক করলে দেখাবে)</label><textarea name="answer" rows="4" required maxlength="5000"><%= item.answer || '' %></textarea>
<label>বিষয়</label><input name="subject" value="<%= item.subject || 'সাধারণ' %>" maxlength="100">
<label>অধ্যায়</label><input name="chapter" value="<%= item.chapter || '' %>" maxlength="100">
<label>পর্ব *</label><select name="phase">
  <option value="abedonpotrer-purbe" <%= (!item.phase || item.phase === 'abedonpotrer-purbe') ? 'selected' : '' %>>আবেদনপত্রের পূর্বে</option>
  <option value="proshnopotrer-purbe" <%= item.phase === 'proshnopotrer-purbe' ? 'selected' : '' %>>প্রশ্নপত্রের পূর্বে</option>
  <option value="shopother-purbe" <%= item.phase === 'shopother-purbe' ? 'selected' : '' %>>শপথের পূর্বে</option>
</select>
<button class="btn primary" type="submit">সেভ করুন</button>
</form></main>
<script src="/js/main.js?v=<%= typeof assetVer !== 'undefined' ? assetVer : '1' %>"></script>
</body></html>
