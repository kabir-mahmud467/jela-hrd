<!DOCTYPE html>
<html lang="bn">
<head>
<title>প্রশ্ন | Admin</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('../partials/icons') %>
<%- include('partials/nav', { active: 'questions', admin: typeof admin !== 'undefined' ? admin : null }) %>
<main class="container admin-main">
<div class="sec-head">
  <span class="sec-ico"><svg class="icon"><use href="#i-help"/></svg></span>
  <h2>প্রশ্ন তালিকা</h2>
  <a href="/admin/questions/new" class="btn primary small">+ নতুন প্রশ্ন</a>
</div>
<p class="muted share-row">প্রতিটি প্রশ্নের পাবলিক পেজ: <code>/questions/:slug</code> — অ্যাডমিন থেকে প্রশ্ন+উত্তর যোগ করুন।</p>
<div class="table-wrap"><table class="table"><tr><th>প্রশ্ন</th><th>বিষয়</th><th>পাবলিক লিংক</th><th>অ্যাকশন</th></tr>
<% items.forEach(i => { %><tr><td><%= (i.question || '').substring(0,60) %></td><td><%= i.subject %></td><td><a href="/questions/<%= i.slug || i._id %>" target="_blank" rel="noopener">দেখুন</a></td>
<td><div class="table-actions"><a href="/admin/questions/<%= i._id %>/edit" class="btn small">এডিট</a>
<form method="POST" action="/admin/questions/<%= i._id %>/delete" class="inline-form" data-confirm="ডিলিট করবেন?"><button class="btn small danger" type="submit">ডিলিট</button></form></div></td></tr><% }) %>
</table></div>
</main>
<%- include('partials/foot') %>
