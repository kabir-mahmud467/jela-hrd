<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>প্রশ্ন | Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include('../partials/icons') %>
<header class="navbar admin-nav" id="navbar"><div class="container nav-inner"><a href="/admin" class="logo"><svg class="icon"><use href="#i-gear"/></svg> Admin</a><nav id="mainnav"><a href="/admin">ড্যাশবোর্ড</a><a href="/admin/logout" class="admin-btn">লগআউট</a></nav></div></header>
<main class="container">
<div class="sec-head">
  <span class="sec-ico"><svg class="icon"><use href="#i-help"/></svg></span>
  <h2>প্রশ্ন তালিকা</h2>
  <a href="/admin/questions/new" class="btn primary small">+ নতুন প্রশ্ন</a>
</div>
<p class="muted share-row">প্রতিটি প্রশ্নের পাবলিক পেজ: <code>/questions/:slug</code> — অ্যাডমিন থেকে প্রশ্ন+উত্তর যোগ করুন।</p>
<div class="table-wrap"><table class="table"><tr><th>প্রশ্ন</th><th>বিষয়</th><th>পাবলিক লিংক</th><th>অ্যাকশন</th></tr>
<% items.forEach(i => { %><tr><td><%= (i.question || '').substring(0,60) %></td><td><%= i.subject %></td><td><a href="/questions/<%= i.slug || i._id %>" target="_blank" rel="noopener">দেখুন</a></td>
<td><a href="/admin/questions/<%= i._id %>/edit" class="btn small">এডিট</a>
<form method="POST" action="/admin/questions/<%= i._id %>/delete" class="inline-form" data-confirm="ডিলিট করবেন?"><button class="btn small danger" type="submit">ডিলিট</button></form></td></tr><% }) %>
</table></div>
</main>
<button class="to-top" id="toTop" aria-label="উপরে যান"><svg class="icon"><use href="#i-top"/></svg></button>
<script src="/js/main.js"></script>
</body></html>
