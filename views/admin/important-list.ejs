<!DOCTYPE html>
<html lang="bn">
<head>
<title>গুরুত্বপূর্ণ | Admin</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('../partials/icons') %>
<%- include('partials/nav', { active: 'importants', admin: typeof admin !== 'undefined' ? admin : null }) %>
<main class="container admin-main">
<div class="sec-head">
  <span class="sec-ico"><svg class="icon"><use href="#i-star"/></svg></span>
  <h2>গুরুত্বপূর্ণ তালিকা</h2>
  <a href="/admin/importants/new" class="btn primary small">+ নতুন</a>
</div>
<div class="table-wrap"><table class="table"><tr><th>শিরোনাম</th><th>ক্যাটাগরি</th><th>পিনড</th><th>অ্যাকশন</th></tr>
<% items.forEach(i => { %><tr><td><%= i.title %></td><td><%= i.category %></td><td><%- i.isPinned ? '<svg class="icon sm"><use href="#i-pin"/></svg>' : '' %></td>
<td><div class="table-actions"><a href="/admin/importants/<%= i._id %>/edit" class="btn small">এডিট</a>
<form method="POST" action="/admin/importants/<%= i._id %>/delete" class="inline-form" data-confirm="ডিলিট করবেন?"><button class="btn small danger" type="submit">ডিলিট</button></form></div></td></tr><% }) %>
</table></div>
</main>
<%- include('partials/foot') %>
