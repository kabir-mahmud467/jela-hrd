<!DOCTYPE html>
<html lang="bn">
<head>
<title>দুআ ফর্ম | Admin</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('../partials/icons') %>
<%- include('partials/nav', { active: 'duas', admin: typeof admin !== 'undefined' ? admin : null }) %>
<main class="container admin-main">
<div class="sec-head">
  <span class="sec-ico"><svg class="icon"><use href="#i-star"/></svg></span>
  <h2><%= item && item._id ? 'এডিট' : 'নতুন' %> মাসনুন দুআ</h2>
  <a href="/admin/duas" class="btn small">তালিকা</a>
</div>
<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
<form method="POST" action="<%= item && item._id ? '/admin/duas/' + item._id : '/admin/duas' %>" class="form">
<label for="f-phase">পর্ব *</label><select id="f-phase" name="phase">
  <option value="abedonpotrer-purbe" <%= (!item.phase || item.phase === 'abedonpotrer-purbe') ? 'selected' : '' %>>আবেদনপত্রের পূর্বে</option>
  <option value="proshnopotrer-purbe" <%= item.phase === 'proshnopotrer-purbe' ? 'selected' : '' %>>প্রশ্নপত্রের পূর্বে</option>
  <option value="shopother-purbe" <%= item.phase === 'shopother-purbe' ? 'selected' : '' %>>শপথের পূর্বে</option>
</select>
<label for="f-title">শিরোনাম</label><input id="f-title" name="title" value="<%= item.title || '' %>" required maxlength="300">
<label for="f-arabic">আরবি পাঠ</label><textarea id="f-arabic" name="arabic" rows="3" dir="auto" maxlength="2000"><%= item.arabic || '' %></textarea>
<label for="f-trans">বাংলা উচ্চারণ</label><textarea id="f-trans" name="transliteration" rows="2" maxlength="2000" placeholder="যেমন: আল্লাহুম্মা আনতা রাব্বি..."><%= item.transliteration || '' %></textarea>
<label for="f-content">অর্থ / ব্যাখ্যা</label><textarea id="f-content" name="content" rows="6" required maxlength="10000"><%= item.content || '' %></textarea>
<label for="f-ref">রেফারেন্স (যেমন: সহিহ বুখারি)</label><input id="f-ref" name="reference" value="<%= item.reference || '' %>" maxlength="300">
<div class="form-actions"><button class="btn primary" type="submit">সেভ করুন</button><a href="/admin/duas" class="btn">বাতিল</a></div>
</form>
</main>
<%- include('partials/foot') %>
