<!DOCTYPE html>
<html lang="bn">
<head>
<title>IP ব্যান | Admin</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav', { active: 'bans', admin }) %>
<main class="container">
<div class="sec-head">
  <span class="sec-ico"><svg class="icon"><use href="#i-lock"/></svg></span>
  <h2>IP ব্যান</h2>
  <span class="badge light"><%= items.length %> ব্যানড</span>
  <a href="/admin/security" class="btn small primary">আক্রমণকারী দেখুন</a>
</div>
<p class="muted">ব্যানড IP সঙ্গে সঙ্গে 403 পাবে (rate limit-এর আগেই ব্লক)। আপনার IP: <span class="ip-pill"><%= myIp %></span> · কে আক্রমণ করছে বুঝতে <a href="/admin/security" class="more">সিকিউরিটি সেন্টার</a> দেখুন।</p>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (success) { %><div class="alert success"><%= success %></div><% } %>
<form method="POST" action="/admin/bans" class="form">
  <label>IP ঠিকানা * (IPv4/IPv6)</label>
  <input name="ip" required maxlength="100" placeholder="যেমন: 203.0.113.45" autocomplete="off" value="<%= typeof prefill !== 'undefined' ? prefill : '' %>">
  <label>কারণ (ঐচ্ছিক)</label>
  <input name="reason" maxlength="300" placeholder="যেমন: বারবার ভুল লগিন">
  <button class="btn primary" type="submit">ব্যান করুন</button>
</form>
<div class="table-wrap mt-16"><table class="table"><tr><th>IP</th><th>কারণ</th><th>তারিখ</th><th>অ্যাকশন</th></tr>
<% if (items.length === 0) { %><tr><td colspan="4" class="muted">কোনো IP ব্যান নেই।</td></tr><% } %>
<% items.forEach(i => { %><tr><td><span class="ip-pill"><%= i.ip %></span></td><td><%= i.reason || '-' %></td><td><%= i.createdAt ? new Date(i.createdAt).toLocaleDateString('bn-BD') : '-' %></td>
<td><form method="POST" action="/admin/bans/<%= i._id %>/delete" class="inline-form" data-confirm="এই IP মুক্ত করবেন?"><button class="btn small" type="submit">মুক্ত করুন</button></form></td></tr><% }) %>
</table></div>
</main>
<%- include('partials/foot') %>
