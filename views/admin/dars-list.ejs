<!DOCTYPE html>
<html lang="bn">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>দারস | Admin</title><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include('../partials/icons') %>

<header class="navbar admin-nav" id="navbar"><div class="container nav-inner"><a href="/admin" class="logo"><svg class="icon"><use href="#i-gear"/></svg> Admin</a><nav id="mainnav"><a href="/admin">ড্যাশবোর্ড</a><a href="/admin/logout" class="admin-btn">লগআউট</a></nav></div></header>
<main class="container">
<h1><svg class="icon"><use href="#i-book"/></svg> দারস তালিকা <a href="/admin/dars/new" class="btn primary small">+ নতুন</a></h1>
<div class="chips">
  <a href="/admin/dars" class="chip">সব</a>
  <a href="/dars/dhara/darsul-quran" class="chip">দারসুল কুরআন</a>
  <a href="/dars/dhara/darsul-hadis" class="chip">দারসুল হাদিস</a>
</div>
<div class="table-wrap"><table class="table"><tr><th>শিরোনাম</th><th>ধারা</th><th>অ্যাকশন</th></tr>
<% items.forEach(i => { %><tr><td><%= i.title %></td><td><%= i.kind === 'darsul-quran' ? 'দারসুল কুরআন' : 'দারসুল হাদিস' %></td>
<td><a href="/admin/dars/<%= i._id %>/edit" class="btn small">এডিট</a>
<form method="POST" action="/admin/dars/<%= i._id %>/delete" class="inline-form" data-confirm="ডিলিট করবেন?"><button class="btn small danger" type="submit">ডিলিট</button></form></td></tr><% }) %>
</table></div>
</main>
<button class="to-top" id="toTop" aria-label="উপরে যান"><svg class="icon"><use href="#i-top"/></svg></button>
<script src="/js/main.js"></script></body></html>
