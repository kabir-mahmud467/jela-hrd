<!DOCTYPE html>
<html lang="bn">
<head>
<title>বিবিধ ফর্ম | Admin</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('../partials/icons') %>
<%- include('partials/nav', { active: 'bibidh', admin: typeof admin !== 'undefined' ? admin : null }) %>
<main class="container admin-main">
<div class="sec-head">
  <span class="sec-ico"><svg class="icon"><use href="#i-book"/></svg></span>
  <h2><%= item && item._id ? 'এডিট' : 'নতুন' %> বিবিধ</h2>
  <a href="/admin/bibidh" class="btn small">তালিকা</a>
</div>
<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
<form method="POST" action="<%= item && item._id ? '/admin/bibidh/' + item._id : '/admin/bibidh' %>" class="form">
<% var cats = {'ilmul-quran':'ইলমূল কুরআন','ilmul-hadis':'ইলমূল হাদিস','ilmut-tajbid':'ইলমুত তাজবীদ','masala-masayel':'মাসআলা-মাসায়েল','shane-nuzul':'শানে নুযুল','jiboni':'জীবনী','dibosh':'দিবস','motobad':'মতবাদ','guruttopurno-ghotonaboli':'গুরুত্বপূর্ণ ঘটনাবলী','jatiyo-antorjatik':'জাতীয় ও আন্তর্জাতিক','onnanno-proshno':'অন্যান্য প্রশ্ন','samprotik-proshno':'সাম্প্রতিক প্রশ্ন'}; %>
<label for="f-cat">বিষয় *</label><select id="f-cat" name="category">
  <% Object.keys(cats).forEach(function(val){ %>
    <option value="<%= val %>" <%= ((!item.category && val === 'ilmul-quran') || item.category === val) ? 'selected' : '' %>><%= cats[val] %></option>
  <% }) %>
</select>
<label for="f-title">শিরোনাম</label><input id="f-title" name="title" value="<%= item.title || '' %>" required maxlength="300">
<label for="f-ref">রেফারেন্স</label><input id="f-ref" name="reference" value="<%= item.reference || '' %>" maxlength="300">
<label for="f-content">বিস্তারিত</label><textarea id="f-content" name="content" rows="8" required maxlength="10000"><%= item.content || '' %></textarea>
<div class="form-actions"><button class="btn primary" type="submit">সেভ করুন</button><a href="/admin/bibidh" class="btn">বাতিল</a></div>
</form>
</main>
<%- include('partials/foot') %>
