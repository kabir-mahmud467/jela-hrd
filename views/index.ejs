  var current='abedonpotrer-purbe';
  function load(){
    try{return JSON.parse(localStorage.getItem(KEY)||'{}')}catch(e){return {}}
  }
  function save(o){ try{localStorage.setItem(KEY,JSON.stringify(o))}catch(e){} }
  function render(){
    var store=load();
    var list=data[current]||[];
    var done=list.filter(function(_,i){return !!store[current+'-'+i]}).length;
    var pct=list.length?Math.round(done/list.length*100):0;
    document.getElementById('checklist-bar').style.width=pct+'%';
    document.getElementById('checklist-count').textContent=done+'/'+list.length;
    document.getElementById('checklist-progress').textContent=pct+'% সম্পন্ন';
    var html='';
    var lastCat='';
    for(var i=0;i<list.length;i++){
      var it=list[i];
      var key=current+'-'+i;
      var checked=store[key]?'checked':'';
      if(it.c!==lastCat){ html+='<div style="margin:10px 0 4px;font-weight:700;color:var(--navy);font-size:13px;border-left:3px solid var(--sky);padding-left:8px">'+it.c+'</div>'; lastCat=it.c; }
      html+='<label style="display:flex;gap:8px;align-items:flex-start;padding:7px 8px;border:1px solid var(--line-soft);border-radius:8px;margin-bottom:6px;background:#fff;cursor:pointer"><input type="checkbox" data-k="'+key+'" '+checked+' style="margin-top:3px"> <span style="font-size:14px;line-height:1.5">'+(i+1)+'. '+it.t+'</span></label>';
    }
    document.getElementById('checklist-list').innerHTML=html;
    var boxes=document.querySelectorAll('#checklist-list input[type=checkbox]');
    for(var j=0;j<boxes.length;j++) boxes[j].addEventListener('change',function(e){
      var s=load(); s[e.target.getAttribute('data-k')]=e.target.checked; if(!e.target.checked) delete s[e.target.getAttribute('data-k')]; save(s); render();
    });
  }
  document.getElementById('checklist-tabs').addEventListener('click',function(e){
    var b=e.target.closest('[data-check-phase]'); if(!b) return;
    current=b.getAttribute('data-check-phase');
    var chips=document.querySelectorAll('#checklist-tabs .chip'); for(var i=0;i<chips.length;i++) chips[i].classList.remove('active');
    b.classList.add('active'); render();
  });
  document.getElementById('checklist-reset').addEventListener('click',function(){
    if(!confirm('এই পর্বের সব টিক মুছবেন?')) return;
    var s=load(); var list=data[current]||[]; for(var i=0;i<list.length;i++) delete s[current+'-'+i]; save(s); render();
  });
  render();
})();
</script>
