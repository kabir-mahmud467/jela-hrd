      <article class="card social reveal">
        <div class="post-head">
          <span class="avatar av<%= (di % 3) + 1 %>"><%= (d.title || 'দ').charAt(0) %></span>
          <div class="post-id">
            <a href="/dua/<%= d._id %>" class="post-title"><%= d.title %></a>
            <div class="post-meta">মাসনুন দুআ</div>
          </div>
        </div>
        <div class="post-foot">
          <a href="/dua/<%= d._id %>" class="more">অর্থসহ <svg class="icon sm"><use href="#i-arrow"/></svg></a>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="sec-star">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-star"/></svg></span>
    <h2>গুরুত্বপূর্ণ তথ্য</h2>
    <a href="/gurutto" class="more">সব তথ্য <svg class="icon sm"><use href="#i-arrow"/></svg></a>
  </div>
  <div class="grid">
    <% if (!importants || importants.length === 0) { %><p class="empty">এখনো কোনো তথ্য যোগ হয়নি।</p><% } %>
    <% (importants || []).forEach((i, ii) => { %>
      <article class="card social reveal <%= i.isPinned ? 'pinned' : '' %>">
        <div class="post-head">
          <span class="avatar av<%= (ii % 3) + 1 %>"><%= (i.title || 'জ').charAt(0) %></span>
          <div class="post-id">
            <a href="/gurutto/<%= i._id %>" class="post-title"><%= i.title %></a>
            <div class="post-meta"><%= i.category || 'তথ্য' %></div>
          </div>
          <% if (i.isPinned) { %><span class="badge pin"><svg class="icon sm"><use href="#i-pin"/></svg> পিনড</span><% } %>
        </div>
        <p class="post-text"><%= (i.description || '').substring(0, 110) %></p>
      </article>
    <% }) %>
  </div>
</section>

