<%- include('partials/header', { title: 'হোম' }) %>

<section class="sec-star" id="checklist-sec">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-book"/></svg></span>
    <h2>সদস্য মানোন্নয়ন চেকলিস্ট</h2>
    <span class="badge" id="checklist-progress">0% সম্পন্ন</span>
  </div>
  <p class="page-sub">৩ পর্বের সব আইটেম — টিক দিলে ব্রাউজারে সংরক্ষিত থাকবে (localStorage)। <a href="/ayat-hadith">আয়াত-হাদিসের আলাদা পাতা</a></p>
  <div class="chips" id="checklist-tabs">
    <button type="button" class="chip active" data-check-phase="abedonpotrer-purbe">আবেদনপত্রের পূর্বে</button>
    <button type="button" class="chip" data-check-phase="proshnopotrer-purbe">প্রশ্নপত্রের পূর্বে</button>
    <button type="button" class="chip" data-check-phase="shopother-purbe">শপথের পূর্বে</button>
  </div>
  <div class="panel">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
      <div class="bar" style="flex:1;min-width:140px"><i id="checklist-bar" style="width:0%"></i></div>
      <span class="muted" id="checklist-count">0/0</span>
      <button type="button" class="btn small" id="checklist-reset">রিসেট</button>
    </div>
    <div id="checklist-list" class="qa-list">
      <% var _initial = (typeof checklistData !== 'undefined' && checklistData['abedonpotrer-purbe']) ? checklistData['abedonpotrer-purbe'] : []; var _last=''; var _catNum=0; %>
      <% _initial.forEach(function(it,i){ %>
        <% if(it.c !== _last){ _catNum=1; %><div style="margin:10px 0 4px;font-weight:700;color:var(--navy);font-size:13px;border-left:3px solid var(--sky);padding-left:8px"><%= it.c %></div><% _last=it.c; } else { _catNum++; } %>
        <label style="display:flex;gap:8px;align-items:flex-start;padding:7px 8px;border:1px solid var(--line-soft);border-radius:8px;margin-bottom:6px;background:#fff;cursor:pointer"><input type="checkbox" data-k="abedonpotrer-purbe-<%= i %>" style="margin-top:3px"> <span style="font-size:14px;line-height:1.5"><%= _catNum %>. <%= it.t %></span></label>
      <% }) %>
    </div>
  </div>
</section>

<script>
(function(){
  var KEY='jela_checklist_v1';
  var data=<%- JSON.stringify(typeof checklistData !== 'undefined' ? checklistData : {}) %>;
  var current='abedonpotrer-purbe';
  function load(){ try{return JSON.parse(localStorage.getItem(KEY)||'{}')}catch(e){return {}} }
  function save(o){ try{localStorage.setItem(KEY,JSON.stringify(o))}catch(e){} }
  function applyState(){
    var store=load();
    var boxes=document.querySelectorAll('#checklist-list input[type=checkbox]');
    for(var i=0;i<boxes.length;i++){
      var k=boxes[i].getAttribute('data-k');
      if(k) boxes[i].checked=!!store[k];
    }
  }
  function updateProgress(){
    var store=load();
    var list=data[current]||[];
    var done=0;
    for(var i=0;i<list.length;i++) if(store[current+'-'+i]) done++;
    var pct=list.length?Math.round(done/list.length*100):0;
    var bar=document.getElementById('checklist-bar');
    var cnt=document.getElementById('checklist-count');
    var prog=document.getElementById('checklist-progress');
    if(bar) bar.style.width=pct+'%';
    if(cnt) cnt.textContent=done+'/'+list.length;
    if(prog) prog.textContent=pct+'% সম্পন্ন';
  }
  function render(){
    var store=load();
    var list=data[current]||[];
    var done=list.filter(function(_,i){return !!store[current+'-'+i]}).length;
    var pct=list.length?Math.round(done/list.length*100):0;
    document.getElementById('checklist-bar').style.width=pct+'%';
    document.getElementById('checklist-count').textContent=done+'/'+list.length;
    document.getElementById('checklist-progress').textContent=pct+'% সম্পন্ন';
    var html='';
    var lastCat='';
    var catNum=0;
    for(var i=0;i<list.length;i++){
      var it=list[i];
      var key=current+'-'+i;
      var checked=store[key]?'checked':'';
      if(it.c!==lastCat){ catNum=1; html+='<div style="margin:10px 0 4px;font-weight:700;color:var(--navy);font-size:13px;border-left:3px solid var(--sky);padding-left:8px">'+it.c+'</div>'; lastCat=it.c; } else { catNum++; }
      html+='<label style="display:flex;gap:8px;align-items:flex-start;padding:7px 8px;border:1px solid var(--line-soft);border-radius:8px;margin-bottom:6px;background:#fff;cursor:pointer"><input type="checkbox" data-k="'+key+'" '+checked+' style="margin-top:3px"> <span style="font-size:14px;line-height:1.5">'+catNum+'. '+it.t+'</span></label>';
    }
    document.getElementById('checklist-list').innerHTML=html;
    var boxes=document.querySelectorAll('#checklist-list input[type=checkbox]');
    for(var j=0;j<boxes.length;j++) boxes[j].addEventListener('change',function(e){
      var s=load(); s[e.target.getAttribute('data-k')]=e.target.checked; if(!e.target.checked) delete s[e.target.getAttribute('data-k')]; save(s); updateProgress();
    });
    updateProgress();
  }
  // apply saved state to server-rendered initial list
  try{ applyState(); updateProgress(); }catch(e){ console.log(e); }
  document.getElementById('checklist-tabs').addEventListener('click',function(e){
    var b=e.target.closest('[data-check-phase]'); if(!b) return;
    current=b.getAttribute('data-check-phase');
    var chips=document.querySelectorAll('#checklist-tabs .chip'); for(var i=0;i<chips.length;i++) chips[i].classList.remove('active');
    b.classList.add('active'); render();
  });
  document.getElementById('checklist-reset').addEventListener('click',function(){
    if(!confirm('এই পর্বের সব টিক মুছবেন?')) return;
    var s=load(); var list=data[current]||[]; for(var i=0;i<list.length;i++) delete s[current+'-'+i]; save(s); render();
  });
  // delegate change for server-rendered checkboxes until first render replaces them
  document.getElementById('checklist-list').addEventListener('change',function(e){
    if(e.target.matches('input[type=checkbox][data-k]')){
      var s=load(); var k=e.target.getAttribute('data-k'); s[k]=e.target.checked; if(!e.target.checked) delete s[k]; save(s); updateProgress();
    }
  });
})();
</script>
<%- include('partials/footer') %>
