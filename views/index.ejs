<%- include('partials/header', { title: 'হোম' }) %>

<section class="hero reveal">
  <span class="hero-badge"><svg class="icon sm"><use href="#i-book"/></svg> সম্পূর্ণ বাংলায় পড়াশোনা</span>
  <h1>পরীক্ষার প্রস্তুতি <span class="hl">সহজ ভাষায়</span></h1>
  <p>প্রশ্নোত্তর, বই, আলোচনা নোট, দারস, মাসনুন দুআ ও গুরুত্বপূর্ণ তথ্য — সব এক জায়গায়। মোট <b><%= qCount %></b>টি প্রশ্ন, <b><%= bookCount %></b>টি বই, <b><%= noteCount %></b>টি আলোচনা নোট, <b><%= darsCount %></b>টি দারস, <b><%= duaCount %></b>টি দুআ।</p>
  <div class="hero-btns">
    <a href="/questions" class="btn primary"><svg class="icon"><use href="#i-help"/></svg> প্রশ্নোত্তর পড়ুন</a>
    <a href="/dars" class="btn"><svg class="icon"><use href="#i-book"/></svg> দারস পড়ুন</a>
    <a href="/dua" class="btn"><svg class="icon"><use href="#i-star"/></svg> মাসনুন দুআ</a>
  </div>
  <form method="GET" action="/questions" class="search hero-search">
    <input type="text" name="q" placeholder="প্রশ্ন খুঁজুন... যেমন: শপথ" maxlength="100">
    <button type="submit"><svg class="icon sm"><use href="#i-search"/></svg> খুঁজুন</button>
  </form>
  <div class="hero-stats">
    <a class="hstat" href="/questions"><b><%= qCount %></b><span>প্রশ্নোত্তর</span></a>
    <a class="hstat" href="/books"><b><%= bookCount %></b><span>বই</span></a>
    <a class="hstat" href="/notes"><b><%= noteCount %></b><span>আলোচনা নোট</span></a>
    <a class="hstat" href="/dars"><b><%= darsCount %></b><span>দারস</span></a>
    <a class="hstat" href="/dua"><b><%= duaCount %></b><span>মাসনুন দুআ</span></a>
    <a class="hstat" href="/gurutto"><b><%= impCount %></b><span>গুরুত্বপূর্ণ তথ্য</span></a>
  </div>
</section>

<section class="sec-star" id="checklist-sec">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-check"/></svg></span>
    <h2>সদস্য মানোন্নয়ন চেকলিস্ট</h2>
    <span class="badge" id="checklist-progress">0% সম্পন্ন</span>
    <a href="/সদস্য_মানোন্নয়ন_চেকলিস্ট_২০২৬.pdf" target="_blank" class="more">PDF দেখুন <svg class="icon sm"><use href="#i-download"/></svg></a>
  </div>
  <p class="page-sub">PDF এর ৩ পর্বের সব আইটেম — টিক দিলে ব্রাউজারে সংরক্ষিত থাকবে (localStorage)।</p>
  <div class="chips" id="checklist-tabs">
    <button type="button" class="chip active" data-check-phase="abedonpotrer-purbe">আবেদনপত্রের পূর্বে</button>
    <button type="button" class="chip" data-check-phase="proshnopotrer-purbe">প্রশ্নপত্রের পূর্বে</button>
    <button type="button" class="chip" data-check-phase="shopother-purbe">শপথের পূর্বে</button>
  </div>
  <div class="panel">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
      <div class="bar" style="flex:1;min-width:140px"><i id="checklist-bar" style="width:0%"></i></div>
      <span class="muted" id="checklist-count">0/0</span>
      <button type="button" class="btn small" id="checklist-reset">রিসেট</button>
    </div>
    <div id="checklist-list" class="qa-list"></div>
  </div>
</section>

<section class="sec-qa">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-layers"/></svg></span>
    <h2>প্রশ্নের ৩টি পর্ব</h2>
    <a href="/questions" class="more">সব প্রশ্ন <svg class="icon sm"><use href="#i-arrow"/></svg></a>
  </div>
  <div class="phase-grid">
    <a href="/questions/phase/abedonpotrer-purbe" class="phase-card p1 reveal">
      <span class="p-num">পর্ব ১</span>
      <h3>আবেদনপত্রের পূর্বে</h3>
      <p>শুরু থেকে প্রস্তুতির ভিত্তি — প্রাথমিক প্রশ্নোত্তর।</p>
      <span class="p-count"><%= (phaseCounts && phaseCounts['abedonpotrer-purbe']) || 0 %>টি প্রশ্ন</span>
      <span class="p-link">পড়ুন <svg class="icon sm"><use href="#i-arrow"/></svg></span>
    </a>
    <a href="/questions/phase/proshnopotrer-purbe" class="phase-card p2 reveal">
      <span class="p-num">পর্ব ২</span>
      <h3>প্রশ্নপত্রের পূর্বে</h3>
      <p>মূল পরীক্ষার প্রশ্নপত্র কেন্দ্রিক চর্চা।</p>
      <span class="p-count"><%= (phaseCounts && phaseCounts['proshnopotrer-purbe']) || 0 %>টি প্রশ্ন</span>
      <span class="p-link">পড়ুন <svg class="icon sm"><use href="#i-arrow"/></svg></span>
    </a>
    <a href="/questions/phase/shopother-purbe" class="phase-card p3 reveal">
      <span class="p-num">পর্ব ৩</span>
      <h3>শপথের পূর্বে</h3>
      <p>শেষ মুহূর্তের ঝালাই — শপথের আগের প্রস্তুতি।</p>
      <span class="p-count"><%= (phaseCounts && phaseCounts['shopother-purbe']) || 0 %>টি প্রশ্ন</span>
      <span class="p-link">পড়ুন <svg class="icon sm"><use href="#i-arrow"/></svg></span>
    </a>
  </div>
</section>

<section class="sec-qa">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-help"/></svg></span>
    <h2>সাম্প্রতিক প্রশ্ন</h2>
    <a href="/questions" class="more">সব দেখুন <svg class="icon sm"><use href="#i-arrow"/></svg></a>
  </div>

  <% if (subjects && subjects.length) { %>
  <div class="chips">
    <% subjects.slice(0, 8).forEach(s => { %>
      <a href="/questions/subject/<%= encodeURIComponent(s) %>" class="chip"><%= s %></a>
    <% }) %>
  </div>
  <% } %>

  <%- include('partials/qa-list', { items: questions, prefix: 'home' }) %>

  <div class="center-cta">
    <a href="/questions" class="btn primary"><svg class="icon"><use href="#i-layers"/></svg> সব <%= qCount %>টি প্রশ্ন দেখুন</a>
  </div>
</section>

<section class="sec-book">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-book"/></svg></span>
    <h2>বই</h2>
    <a href="/books" class="more">সব বই <svg class="icon sm"><use href="#i-arrow"/></svg></a>
  </div>
  <div class="grid">
    <% if (!books || books.length === 0) { %><p class="empty">এখনো কোনো বই যোগ হয়নি।</p><% } %>
    <% (books || []).forEach((b, bi) => { %>
      <article class="card social reveal">
        <div class="post-head">
          <span class="avatar av<%= (bi % 3) + 1 %>"><%= (b.title || 'ব').charAt(0) %></span>
          <div class="post-id">
            <span class="post-title"><%= b.title %></span>
            <div class="post-meta"><%= b.author || 'লেখক অজানা' %></div>
          </div>
        </div>
        <p class="post-text"><%= (b.description || '').substring(0, 110) %></p>
        <% if (b.link && (b.link.startsWith('http://') || b.link.startsWith('https://'))) { %>
        <div class="post-foot">
          <a href="<%= b.link %>" target="_blank" rel="noopener" class="more">পড়ুন <svg class="icon sm"><use href="#i-arrow"/></svg></a>
        </div>
        <% } %>
      </article>
    <% }) %>
  </div>
</section>

<section class="sec-note">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-note"/></svg></span>
    <h2>আলোচনা নোট</h2>
    <a href="/notes" class="more">সব নোট <svg class="icon sm"><use href="#i-arrow"/></svg></a>
  </div>
  <div class="grid">
    <% if (!notes || notes.length === 0) { %><p class="empty">এখনো কোনো আলোচনা নোট যোগ হয়নি।</p><% } %>
    <% (notes || []).forEach((n, ni) => { %>
      <article class="card social reveal">
        <div class="post-head">
          <span class="avatar av<%= (ni % 3) + 1 %>"><%= (n.title || 'ন').charAt(0) %></span>
          <div class="post-id">
            <a href="/notes/<%= n._id %>" class="post-title"><%= n.title %></a>
            <div class="post-meta"><%= n.subject || 'নোট' %></div>
          </div>
        </div>
        <p class="post-text"><%= (n.content || '').substring(0, 110) %>...</p>
        <div class="post-foot">
          <a href="/notes/<%= n._id %>" class="more">বিস্তারিত <svg class="icon sm"><use href="#i-arrow"/></svg></a>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="sec-note">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-book"/></svg></span>
    <h2>দারস</h2>
    <a href="/dars" class="more">সব দারস <svg class="icon sm"><use href="#i-arrow"/></svg></a>
  </div>
  <div class="phase-grid">
    <a href="/dars/porbo/abedonpotrer-purbe" class="phase-card p1 reveal">
      <span class="p-num">পর্ব ১</span>
      <h3>আবেদনপত্রের পূর্বে</h3>
      <p>শুরুর দারস — ভিত্তি প্রস্তুতি।</p>
      <span class="p-link">পড়ুন <svg class="icon sm"><use href="#i-arrow"/></svg></span>
    </a>
    <a href="/dars/porbo/proshnopotrer-purbe" class="phase-card p2 reveal">
      <span class="p-num">পর্ব ২</span>
      <h3>প্রশ্নপত্রের পূর্বে</h3>
      <p>মূল পরীক্ষা কেন্দ্রিক দারস।</p>
      <span class="p-link">পড়ুন <svg class="icon sm"><use href="#i-arrow"/></svg></span>
    </a>
    <a href="/dars/porbo/shopother-purbe" class="phase-card p3 reveal">
      <span class="p-num">পর্ব ৩</span>
      <h3>শপথের পূর্বে</h3>
      <p>শেষ মুহূর্তের দারস।</p>
      <span class="p-link">পড়ুন <svg class="icon sm"><use href="#i-arrow"/></svg></span>
    </a>
  </div>
  <div class="grid">
    <% if (!lessons || lessons.length === 0) { %><p class="empty">এখনো কোনো দারস যোগ হয়নি।</p><% } %>
    <% (lessons || []).forEach((l, li) => { %>
      <article class="card social reveal">
        <div class="post-head">
          <span class="avatar av<%= (li % 3) + 1 %>"><%= (l.title || 'দ').charAt(0) %></span>
          <div class="post-id">
            <a href="/dars/<%= l._id %>" class="post-title"><%= l.title %></a>
            <div class="post-meta">দারস</div>
          </div>
        </div>
        <div class="post-foot">
          <a href="/dars/<%= l._id %>" class="more">বিস্তারিত <svg class="icon sm"><use href="#i-arrow"/></svg></a>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="sec-note">
  <div class="sec-head">
    <span class="sec-ico"><svg class="icon"><use href="#i-star"/></svg></span>
    <h2>মাসনুন দুআ</h2>
