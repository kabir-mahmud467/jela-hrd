# ===== Server =====
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/jela_hrd
SESSION_SECRET=change_this_to_a_long_random_string

# ===== Admin Panel (first boot seeds DB, afterwards change from /admin/settings) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_123

# ===== IP ban (optional, comma-separated — সঙ্গে সঙ্গে 403) =====
# BANNED_IPS=203.0.113.45,198.51.100.7

# ===== Vercel env (same keys, set in Vercel Dashboard > Settings > Environment Variables) =====
